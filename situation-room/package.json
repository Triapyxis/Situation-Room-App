{
  "name": "situation-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "app": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "electron/main.cjs",
  "description": "Situation Room: OBS-style results switcher for one laptop",
  "author": "Election Monitor",
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ng.election.situationroom",
    "productName": "Situation Room",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "public/**",
      "server.mjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Situation Room",
      "artifactName": "Situation-Room-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Triapyxis",
        "repo": "Situation-Room-App",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "repository": "https://github.com/Triapyxis/Situation-Room-App"
}
